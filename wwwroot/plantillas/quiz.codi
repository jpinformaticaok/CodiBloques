{"Version":"1.0","FechaGuardado":"2026-01-01T00:00:00","XmlBlockly":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><block type=\"codi_bandera\" x=\"20\" y=\"20\"><next><block type=\"codi_cambiar_disfraz\"><field name=\"DISFRAZ\">robot</field><next><block type=\"codi_fijar_puntos\"><value name=\"N\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><next><block type=\"codi_decir_seg\"><value name=\"MSG\"><shadow type=\"text\"><field name=\"TEXT\">¡Bienvenido al Quiz!</field></shadow></value><value name=\"SECS\"><shadow type=\"math_number\"><field name=\"NUM\">2</field></shadow></value><next><block type=\"codi_preguntar\"><value name=\"Q\"><shadow type=\"text\"><field name=\"TEXT\">¿Cuánto es 2 + 2?</field></shadow></value><next><block type=\"codi_si_sino\"><value name=\"COND\"><block type=\"logic_compare\"><field name=\"OP\">EQ</field><value name=\"A\"><block type=\"codi_respuesta\"/></value><value name=\"B\"><shadow type=\"text\"><field name=\"TEXT\">4</field></shadow></value></block></value><statement name=\"DO\"><block type=\"codi_decir_seg\"><value name=\"MSG\"><shadow type=\"text\"><field name=\"TEXT\">¡Correcto! 🎉</field></shadow></value><value name=\"SECS\"><shadow type=\"math_number\"><field name=\"NUM\">2</field></shadow></value><next><block type=\"codi_sumar_puntos\"><value name=\"N\"><shadow type=\"math_number\"><field name=\"NUM\">10</field></shadow></value></block></next></block></statement><statement name=\"ELSE\"><block type=\"codi_decir_seg\"><value name=\"MSG\"><shadow type=\"text\"><field name=\"TEXT\">¡Incorrecto! La respuesta es 4</field></shadow></value><value name=\"SECS\"><shadow type=\"math_number\"><field name=\"NUM\">2</field></shadow></value></block></statement></block></next></block></next></block></next></block></next></block></next></block></xml>","Nombre":"Quiz de Preguntas","Descripcion":"Un robot hace preguntas y evalúa las respuestas. Modificá las preguntas y respuestas.","Categoria":"Educativo","Nivel":"Principiante"}