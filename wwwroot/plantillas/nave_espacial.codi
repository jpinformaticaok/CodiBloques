{"Version":"1.0","FechaGuardado":"2026-01-01T00:00:00","XmlBlockly":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><block type=\"codi_bandera\" x=\"20\" y=\"20\"><next><block type=\"codi_cambiar_fondo\"><field name=\"FONDO\">0</field><next><block type=\"codi_cambiar_disfraz\"><field name=\"DISFRAZ\">cohete</field><next><block type=\"codi_ir_a\"><value name=\"X\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><value name=\"Y\"><shadow type=\"math_number\"><field name=\"NUM\">-80</field></shadow></value><next><block type=\"codi_fijar_puntos\"><value name=\"N\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value><next><block type=\"codi_siempre\"><statement name=\"DO\"><block type=\"codi_si\"><value name=\"COND\"><block type=\"codi_tecla_pulsada\"><field name=\"TECLA\">ArrowLeft</field></block></value><statement name=\"DO\"><block type=\"codi_cambiar_x\"><value name=\"DX\"><shadow type=\"math_number\"><field name=\"NUM\">-5</field></shadow></value></block></statement><next><block type=\"codi_si\"><value name=\"COND\"><block type=\"codi_tecla_pulsada\"><field name=\"TECLA\">ArrowRight</field></block></value><statement name=\"DO\"><block type=\"codi_cambiar_x\"><value name=\"DX\"><shadow type=\"math_number\"><field name=\"NUM\">5</field></shadow></value></block></statement><next><block type=\"codi_rebotar\"/></next></block></next></block></statement></block></next></block></next></block></next></block></next></block></next></block></xml>","Nombre":"Nave Espacial","Descripcion":"Controlá una nave con las flechas del teclado. Base para crear tu propio juego espacial.","Categoria":"Juegos","Nivel":"Principiante"}